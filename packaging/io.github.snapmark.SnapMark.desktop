[Desktop Entry]
Type=Application
Version=1.0
Name=SnapMark
Comment=Capture screenshots, record your screen and annotate locally
Exec=snapmark %f
Icon=io.github.snapmark.SnapMark
Terminal=false
Categories=Graphics;Qt;
MimeType=image/png;image/jpeg;image/webp;video/mp4;video/webm;video/x-matroska;video/quicktime;
StartupNotify=true
Actions=Full;Region;

[Desktop Action Full]
Name=Capture Full Screen
Exec=snapmark --capture full

[Desktop Action Region]
Name=Capture Region
Exec=snapmark --capture region
